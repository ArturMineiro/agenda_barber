// Navalha — modelo de dados
// Multi-tenant: tudo que pertence a uma barbearia carrega barbershopId.
// Valores em dinheiro em centavos (Int). Datas/horas de agendamento em UTC (timestamptz).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN // dono da plataforma
  OWNER // dono de barbearia
  BARBER // profissional com login (futuro)
  CLIENT // cliente com login (futuro)
}

enum BarbershopStatus {
  PENDING // aguardando aprovação do super admin
  ACTIVE
  SUSPENDED // mensalidade atrasada ou bloqueio manual
  REJECTED
}

enum TeamType {
  SOLO
  TEAM
}

/// Como a barbearia atende
/// Fundo da página pública (paletas no frontend: lib/theme.ts)
enum PageTheme {
  LIGHT
  DARK
  CREAM
  ICE
  GRAPHITE
  NAVY
  GREEN
  WINE
  COFFEE
}

enum BookingMode {
  SCHEDULE // agenda com horário marcado
  QUEUE // ordem de chegada (fila presencial por barbeiro)
}

enum QueueStatus {
  WAITING
  IN_SERVICE
  DONE
  NO_SHOW
  CANCELED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum AppointmentStatus {
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SHOW
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role
  /// sobe a cada troca de senha: sessões abertas com a senha antiga deixam de valer
  tokenVersion Int      @default(0)
  /// entrou com senha temporária (gerada pelo admin ou pelo dono): precisa criar a própria
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershops  Barbershop[]
  professional Professional?
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Plan {
  id               String   @id @default(cuid())
  name             String
  description      String?
  priceCents       Int
  /// null = ilimitado
  maxProfessionals Int?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Barbershop {
  id          String           @id @default(cuid())
  ownerId     String
  slug        String           @unique
  name        String
  status      BarbershopStatus @default(PENDING)
  teamType    TeamType
  bookingMode BookingMode      @default(SCHEDULE)
  /// fundo da página pública: claro ou escuro
  pageTheme   PageTheme        @default(LIGHT)
  description String?
  phone       String?
  whatsapp    String?
  instagram   String?
  address     String?
  city        String?
  logoUrl     String?
  coverUrl    String?
  primaryColor   String       @default("#b45309")
  /// cor de apoio: fundo do topo, logo sem imagem
  secondaryColor String       @default("#1c1917")
  timezone    String           @default("America/Sao_Paulo")

  // Regras de agenda
  slotIntervalMinutes Int @default(30)
  minAdvanceMinutes   Int @default(60)
  maxAdvanceDays      Int @default(30)
  /// até quantos minutos antes o cliente pode cancelar/remarcar sozinho
  cancelMinAdvanceMinutes Int @default(120)
  /// hora (no fuso da barbearia) do aviso "amanhã você tem N clientes"; null = desligado
  reminderDigestHour Int? @default(19)
  /// dia local ("2026-11-14") em que o aviso já foi enviado (não repete no mesmo dia)
  reminderDigestOn   String?

  statusReason String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subscription  Subscription?
  services      Service[]
  professionals Professional[]
  appointments  Appointment[]
  queueEntries  QueueEntry[]
  pushSubscriptions PushSubscription[]
  servicePhotos ServicePhoto[]
  reviews       Review[]
  auditLogs     AuditLog[]

  @@index([ownerId])
  @@index([status])
  @@map("barbershops")
}

model Subscription {
  id           String             @id @default(cuid())
  barbershopId String             @unique
  planId       String
  status       SubscriptionStatus
  /// valor mensal negociado (pode diferir do preço do plano)
  priceCents   Int
  /// dia do mês do vencimento (1–28)
  billingDay   Int
  trialEndsAt  DateTime?
  startedAt    DateTime           @default(now())
  canceledAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  plan       Plan       @relation(fields: [planId], references: [id])
  payments   Payment[]

  @@map("subscriptions")
}

/// Mensalidade: uma por mês de referência. Baixa manual pelo super admin (gateway no futuro).
model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  /// "2026-11" — mês de referência
  referenceMonth String
  amountCents    Int
  dueDate        DateTime      @db.Date
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  method         String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, referenceMonth])
  @@index([status, dueDate])
  @@map("payments")
}

model Service {
  id              String   @id @default(cuid())
  barbershopId    String
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  barbershop    Barbershop            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]
  appointments  Appointment[]
  queueEntries  QueueEntry[]
  photos        ServicePhoto[]
  reviews       Review[]

  @@index([barbershopId])
  @@map("services")
}

model Professional {
  id           String   @id @default(cuid())
  barbershopId String
  /// login próprio do profissional (opcional)
  userId       String?  @unique
  name         String
  bio          String?
  avatarUrl    String?
  active       Boolean  @default(true)
  /// fila aberta para receber clientes (modo ordem de chegada)
  queueOpen    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop   Barbershop            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  services     ProfessionalService[]
  workingHours WorkingHour[]
  timeOffs     TimeOff[]
  appointments Appointment[]
  queueEntries QueueEntry[]
  reviews      Review[]

  @@index([barbershopId])
  @@map("professionals")
}

model ProfessionalService {
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@map("professional_services")
}

/// Grade semanal. Vários registros no mesmo dia = intervalos (ex.: pausa do almoço).
model WorkingHour {
  id             String @id @default(cuid())
  professionalId String
  /// 0 = domingo … 6 = sábado
  weekday        Int
  /// minutos desde a meia-noite, no fuso da barbearia
  startMinute    Int
  endMinute      Int

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
  @@map("working_hours")
}

/// Bloqueio de agenda: folga, férias, compromisso
model TimeOff {
  id             String   @id @default(cuid())
  professionalId String
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, startsAt])
  @@map("time_offs")
}

model Appointment {
  id             String            @id @default(cuid())
  barbershopId   String
  professionalId String
  serviceId      String
  /// cliente agenda sem conta: nome + telefone
  clientName     String
  clientPhone    String
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(CONFIRMED)
  /// snapshot do preço no momento do agendamento
  priceCents     Int
  notes          String?
  /// "public" = pelo link, "panel" = lançado pelo dono
  source         String            @default("public")
  /// token secreto do link do cliente (ver, cancelar, remarcar sem login)
  accessToken    String            @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-', '')"))
  canceledAt     DateTime?
  /// "client" | "barbershop"
  canceledBy     String?
  cancelReason   String?
  /// quantas vezes o cliente remarcou
  rescheduleCount Int              @default(0)
  /// quando o dono mandou o lembrete pelo WhatsApp
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  barbershop   Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id])
  review       Review?

  @@index([barbershopId, startsAt])
  @@index([professionalId, startsAt])
  @@map("appointments")
}

/// Cliente na fila de um barbeiro (modo ordem de chegada). A ordem é a hora de chegada.
model QueueEntry {
  id             String      @id @default(cuid())
  barbershopId   String
  professionalId String
  serviceId      String?
  clientName     String
  clientPhone    String?
  status         QueueStatus @default(WAITING)
  /// snapshot do preço do serviço (0 se não informado)
  priceCents     Int         @default(0)
  joinedAt       DateTime    @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  barbershop   Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([professionalId, status, joinedAt])
  @@index([barbershopId, joinedAt])
  @@map("queue_entries")
}

/// Celular/navegador que aceitou receber notificações (Web Push) do painel
model PushSubscription {
  id           String    @id @default(cuid())
  userId       String
  barbershopId String
  endpoint     String    @unique
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@map("push_subscriptions")
}

/// Fotos do corte/serviço (catálogo). A de menor posição é a capa.
model ServicePhoto {
  id           String   @id @default(cuid())
  serviceId    String
  barbershopId String
  /// 900x1125 WebP, usada no carrossel e na galeria
  url          String
  /// 240x300 WebP, usada nas listas
  thumbUrl     String
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([serviceId, position])
  @@map("service_photos")
}

/// Avaliação do cliente depois do atendimento (uma por agendamento, feita pelo link secreto)
model Review {
  id             String   @id @default(cuid())
  barbershopId   String
  appointmentId  String   @unique
  /// snapshot do agendamento: média por corte e por profissional
  professionalId String
  serviceId      String
  clientName     String
  /// 1 a 5 estrelas
  rating         Int
  comment        String?
  /// dono pode tirar da página pública (continua visível no painel)
  hidden         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  barbershop   Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([barbershopId, createdAt])
  @@index([serviceId])
  @@map("reviews")
}

/// Log de atividades: quem fez o quê (painel, admin, login, cliente pelo link). Só leitura para o admin.
model AuditLog {
  id           String   @id @default(cuid())
  barbershopId String?
  /// usuário que fez a ação (null = cliente pelo link público ou sistema)
  actorId      String?
  actorName    String?
  /// OWNER | BARBER | SUPER_ADMIN | CLIENT | SYSTEM
  actorRole    String
  /// chave estável, ex.: "panel.service.update"
  action       String
  /// frase legível para a tela, ex.: "Editou o serviço"
  summary      String
  /// dados da requisição já sem senhas/tokens
  details      Json?
  ip           String?
  createdAt    DateTime @default(now())

  barbershop Barbershop? @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
