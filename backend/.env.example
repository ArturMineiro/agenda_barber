NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://navalha:navalha@localhost:5433/navalha?schema=public

# Gere um valor longo e aleatório em produção
JWT_SECRET=troque-este-segredo-por-um-valor-grande-e-aleatorio
JWT_EXPIRES_IN=7d

# Origem do frontend (CORS)
WEB_URL=http://localhost:5173

# Dias de tolerância após o vencimento antes de suspender a barbearia
BILLING_GRACE_DAYS=5

# Notificações no celular (Web Push). Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@navalha.app

# WhatsApp do suporte/admin que aparece para os donos (com DDD)
SUPPORT_WHATSAPP=21967355884

# Super admin criado pelo seed
SEED_ADMIN_EMAIL=admin@navalha.app
SEED_ADMIN_PASSWORD=admin12345
