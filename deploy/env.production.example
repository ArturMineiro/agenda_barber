# Copie para /opt/navalha/.env no servidor (nunca suba este arquivo preenchido para o git).
# Gere valores aleatórios com: openssl rand -hex 32

APP_URL=https://navalha.forgedevapps.com
DB_PASSWORD=troque-por-um-valor-aleatorio
JWT_SECRET=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres

# Porta local que o nginx da VPS usa para chegar no site
WEB_PORT=127.0.0.1:8083

# Dias de tolerância após o vencimento antes de suspender a barbearia
BILLING_GRACE_DAYS=5

# WhatsApp do suporte/admin que aparece para os donos (com DDD)
SUPPORT_WHATSAPP=21967355884

# Super admin criado pelo seed: docker compose -f docker-compose.prod.yml exec api node dist/seed.js
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
